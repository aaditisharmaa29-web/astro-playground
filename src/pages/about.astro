---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Any Guesses?";

const identity = {
  firstName: "Sarah",
  country: "Canada",
  occupation: "Technical Writer",
  hobbies: ["photography", "birdwatching", "baseball"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"]
const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold"
const textCase = "uppercase"
---

<BaseLayout pageTitle={pageTitle}>
  <p>My name is {identity.firstName} and I live in {identity.country} and I work as a {identity.occupation}.</p>

  {happy && <p>I am happy to be learning Astro!</p>}
  {finished && <p>I have completed this course!</p>}
  {goal === 3 && <p>My current goal is: Finish in 3 months</p>}

  <p>My skills are:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  <p>My hobbies are:</p>
  <ul>
    {identity.hobbies.map((hobby) => <li>{hobby}</li>)}
  </ul>

  <style is:global define:vars={{skillColor, fontWeight, textCase}}>
    h1 {
      color: red;
    }
    .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }
  </style>
</BaseLayout>